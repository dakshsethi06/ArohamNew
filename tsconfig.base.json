{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@aroham/shared-types": ["packages/shared-types/src/index.ts"],
      "@aroham/shared-types/*": ["packages/shared-types/src/*"],
      "@aroham/shared-config": ["packages/shared-config/src/index.ts"],
      "@aroham/shared-config/*": ["packages/shared-config/src/*"],
      "@aroham/shared-utils": ["packages/shared-utils/src/index.ts"],
      "@aroham/shared-utils/*": ["packages/shared-utils/src/*"],
      "@aroham/shared-services": ["packages/shared-services/src/index.ts"],
      "@aroham/shared-services/*": ["packages/shared-services/src/*"],
      "@aroham/shared-api": ["packages/shared-api/src/index.ts"],
      "@aroham/shared-api/*": ["packages/shared-api/src/*"],
      "@aroham/shared-auth": ["packages/shared-auth/src/index.ts"],
      "@aroham/shared-auth/*": ["packages/shared-auth/src/*"],
      "@aroham/shared-state": ["packages/shared-state/src/index.ts"],
      "@aroham/shared-state/*": ["packages/shared-state/src/*"],
      "@aroham/shared-hooks": ["packages/shared-hooks/src/index.ts"],
      "@aroham/shared-hooks/*": ["packages/shared-hooks/src/*"],
      "@aroham/shared-validation": ["packages/shared-validation/src/index.ts"],
      "@aroham/shared-validation/*": ["packages/shared-validation/src/*"]
    }
  }
}
