            <% dashaTimeline.forEach((md) => { 
                const mdStart = new Date(md.start);
                const mdEnd = new Date(md.end);
                const isCurrentMd = (now >= mdStart && now <= mdEnd);
                const bgColor = planetColors[md.planet] || '#fcf8e3';
            %>
