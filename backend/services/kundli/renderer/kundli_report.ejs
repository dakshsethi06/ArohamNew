<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= userName %>'s Kundli Report</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');
        
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', Helvetica, Arial, sans-serif;
            color: #333;
            margin: 0;
            padding: 0;
            background: #fff;
            -webkit-print-color-adjust: exact;
        }

        .page {
            width: 100%;
            min-height: 297mm; /* A4 height */
            padding: 50px 60px;
            position: relative;
            page-break-after: always;
        }

        .page:last-child {
            page-break-after: auto;
        }

        /* --- Cover Page Styles --- */
        .cover-page {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            min-height: 297mm;
        }

        .logo-circle {
            width: 120px;
            height: 120px;
            background-color: #f7e135;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 25px;
            border: 2px solid #333;
        }

        .logo-inner {
            width: 80px;
            height: 80px;
            border: 2px solid #333;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        
        .logo-inner::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border: 1px dashed #333;
            border-radius: 50%;
            transform: scale(1.15);
        }

        .logo-sun {
            font-size: 40px;
            line-height: 1;
            color: #111;
        }

        .brand-name {
            letter-spacing: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #666;
            margin-bottom: 20px;
            text-transform: uppercase;
        }

        .report-subtitle {
            letter-spacing: 4px;
            font-size: 13px;
            font-weight: 500;
            color: #888;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .report-title {
            font-size: 48px;
            font-weight: 800;
            color: #8f6a00;
            margin: 0 0 20px 0;
            letter-spacing: -1px;
        }

        .divider {
            width: 150px;
            height: 1px;
            background-color: #b8860b;
            margin: 25px auto;
            position: relative;
        }

        .divider::after {
            content: '';
            position: absolute;
            width: 6px;
            height: 6px;
            background-color: #b8860b;
            border-radius: 50%;
            top: -2.5px;
            left: 50%;
            transform: translateX(-50%);
        }

        .birth-info {
            font-size: 15px;
            font-weight: 400;
            color: #555;
            margin-bottom: 40px;
        }

        .generate-pill {
            background-color: #c48b10;
            color: #111;
            padding: 12px 30px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 60px;
        }

        .cover-footer {
            position: absolute;
            bottom: 50px;
            width: 100%;
            text-align: center;
            font-size: 11px;
            letter-spacing: 3px;
            color: #888;
            text-transform: uppercase;
            font-weight: 500;
        }

        /* --- Internal Pages Styles --- */
        .page-header {
            display: flex;
            align-items: center;
            margin-bottom: 40px;
            position: relative;
        }

        .page-number {
            width: 45px;
            height: 45px;
            background-color: #c48b10;
            color: #111;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            margin-right: 20px;
            z-index: 2;
        }

        .page-title {
            font-size: 26px;
            font-weight: 700;
            color: #111;
            margin: 0;
            z-index: 2;
            background: #fff;
            padding-right: 20px;
        }

        .header-line {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background-color: #d8d8d8;
            z-index: 1;
        }

        .section-heading {
            font-size: 16px;
            font-weight: 700;
            color: #333;
            margin-bottom: 25px;
            text-transform: uppercase;
            border-left: 4px solid #c48b10;
            padding-left: 12px;
            letter-spacing: 1px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
            font-size: 14px;
        }

        th, td {
            text-align: left;
            padding: 16px 12px;
        }

        tr {
            border-bottom: 1px dashed #d8d8d8;
        }

        tr:last-child {
            border-bottom: 1px dashed #d8d8d8; /* Keep bottom dashed line like Astrotalk */
        }

        th {
            color: #888;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 11px;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        td {
            color: #111;
            font-weight: 500;
        }

        .val {
            text-align: right;
        }

        .footer {
            position: absolute;
            bottom: 30px;
            left: 60px;
            right: 60px;
            display: flex;
            justify-content: space-between;
            font-size: 10px;
            color: #666;
            border-top: 1px solid #e0e0e0;
            padding-top: 15px;
            font-weight: 500;
        }

        /* --- North Indian Chart SVG Styles --- */
        .ni-chart-container {
            margin: 0 auto 30px auto;
            text-align: center;
        }
        .ni-title {
            margin: 0 0 15px 0;
            color: #111;
            font-size: 16px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            display: none; /* Astrotalk shows title outside or above, we'll handle outside */
        }
        
        .chart-svg {
            background-color: #fdfaf3; /* Light beige */
            border: 2px solid #a88e5d; /* Darker border */
            border-radius: 8px;
        }
        
        .sign-text {
            font-size: 12px;
            fill: #333;
            text-anchor: middle;
            dominant-baseline: middle;
            font-weight: 700;
        }
        .planet-text {
            font-size: 13px;
            fill: #333;
            text-anchor: middle;
            dominant-baseline: middle;
            font-weight: 700;
        }
        
        /* Astrotalk Planet Colors */
        .color-Su { fill: #e67e22; } /* Orange */
        .color-Mo { fill: #2c3e50; } /* Dark Blue */
        .color-Ma { fill: #e74c3c; } /* Red */
        .color-Me { fill: #27ae60; } /* Green */
        .color-Ju { fill: #f1c40f; } /* Gold/Yellow */
        .color-Ve { fill: #e056fd; } /* Pink */
        .color-Sa { fill: #111111; } /* Black */
        .color-Ra { fill: #7f8c8d; } /* Grey/Brown */
        .color-Ke { fill: #8e44ad; } /* Purple/Brown */
        .color-Ur { fill: #2980b9; } /* Cyan */
        .color-Ne { fill: #16a085; } /* Teal */
        .color-Pl { fill: #8e44ad; } /* Purple */
        
        .chart-row {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 20px;
        }

    </style>
</head>
<body>

    <!-- Cover Page -->
    <div class="page cover-page">
        <div class="logo-circle">
            <div class="logo-inner">
                <span class="logo-sun">☀</span>
            </div>
        </div>
        
        <div class="brand-name">A S T R O L O G Y  B O T</div>
        <div class="report-subtitle">V E D I C  A S T R O L O G Y  R E P O R T</div>
        <h1 class="report-title"><%= userName %>'s Kundli</h1>
        
        <div class="divider"></div>
        
        <div class="birth-info">
            <%= date %> • <%= time %> • <%= location %>
        </div>

        <div class="generate-pill">
            GENERATED <%= new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase() %>
        </div>

        <div class="cover-footer">
            W W W . A S T R O L O G Y B O T . C O M   •   Y O U R   T R U S T E D   A S T R O L O G Y   P A R T N E R
        </div>
    </div>

    <!-- Page 1: Basic Details -->
    <div class="page">
        <div class="page-header">
            <div class="header-line"></div>
            <div class="page-number">01</div>
            <h2 class="page-title">Basic</h2>
        </div>

        <h3 class="section-heading">BIRTH DETAILS</h3>
        <table>
            <tbody>
                <tr>
                    <th>NAME</th>
                    <td><%= userName %></td>
                    <th>GENDER</th>
                    <td class="val"><%= (typeof gender !== 'undefined' && gender) ? gender : 'Male' %></td>
                </tr>
                <tr>
                    <th>DATE OF BIRTH</th>
                    <td><%= date %></td>
                    <th>TIME OF BIRTH</th>
                    <td class="val"><%= time %></td>
                </tr>
                <tr>
                    <th>PLACE OF BIRTH</th>
                    <td><%= location %></td>
                    <th>COORDINATES</th>
                    <td class="val"><%= coordinates %></td>
                </tr>
            </tbody>
        </table>

        <div class="footer">
            <span>Astrology Bot — Your trusted astrology partner · www.astrologybot.com · contact@astrologybot.com</span>
            <span>Page 2</span>
        </div>
    </div>

    <!-- Page 2.5: Panchang & Avakhada Chakra -->
    <div class="page">
        <div class="page-header">
            <div class="header-line"></div>
            <div class="page-number">02</div>
            <h2 class="page-title">Panchang & Avakhada</h2>
        </div>

        <h3 class="section-heading">PANCHANG DETAILS</h3>
        <p style="color: #666; font-size: 13px; margin-bottom: 20px;">The five limbs of time derived from the exact coordinates of your birth.</p>
        
        <% if (panchang) { %>
        <table>
            <tbody>
                <tr>
                    <th>TITHI (LUNAR DAY)</th>
                    <td><%= panchang.Tithi %></td>
                    <th>YOGA</th>
                    <td class="val"><%= panchang.Yoga %></td>
                </tr>
                <tr>
                    <th>KARANA</th>
                    <td><%= panchang.Karana %></td>
                    <th>MOON NAKSHATRA</th>
                    <td class="val"><%= panchang.MoonNakshatra %></td>
                </tr>
                <tr>
                    <th>SUNRISE</th>
                    <td><%= panchang.Sunrise %></td>
                    <th>SUNSET</th>
                    <td class="val"><%= panchang.Sunset %></td>
                </tr>
            </tbody>
        </table>

        <h3 class="section-heading" style="margin-top: 40px;">AVAKHADA CHAKRA</h3>
        <p style="color: #666; font-size: 13px; margin-bottom: 20px;">Traditional classifications based on your Moon's placement.</p>
        
        <% if (panchang.Avakhada) { %>
        <table>
            <tbody>
                <tr>
                    <th>MOON SIGN (RASHI)</th>
                    <td><%= panchang.Avakhada.Sign %></td>
                    <th>SIGN LORD</th>
                    <td class="val"><%= panchang.Avakhada.SignLord %></td>
                </tr>
                <tr>
                    <th>NAKSHATRA</th>
                    <td><%= panchang.Avakhada.Nakshatra %> (Pada <%= panchang.Avakhada.Charan %>)</td>
                    <th>NAME ALPHABET</th>
                    <td class="val"><%= panchang.Avakhada.NameAlphabet %></td>
                </tr>
                <tr>
                    <th>PAYA (MATERIAL)</th>
                    <td><%= panchang.Avakhada.Paya %></td>
                    <th>YUNJA</th>
                    <td class="val"><%= panchang.Avakhada.Yunja %></td>
                </tr>
                <tr>
                    <th>VARNA (CLASS)</th>
                    <td><%= panchang.Avakhada.Varna %></td>
                    <th>VASHYA</th>
                    <td class="val"><%= panchang.Avakhada.Vashya || 'Unknown' %></td>
                </tr>
                <tr>
                    <th>YONI (NATURE)</th>
                    <td><%= panchang.Avakhada.Yoni %></td>
                    <th>GAN (TEMPERAMENT)</th>
                    <td class="val"><%= panchang.Avakhada.Gan %></td>
                </tr>
                <tr>
                    <th>NADI (CONSTITUTION)</th>
                    <td><%= panchang.Avakhada.Nadi %></td>
                    <th>TATVA (ELEMENT)</th>
                    <td class="val"><%= panchang.Avakhada.Tatva %></td>
                </tr>
            </tbody>
        </table>
        <% } %>
        <% } else { %>
            <p>Panchang data not found.</p>
        <% } %>

        <div class="footer">
            <span>Astrology Bot — Your trusted astrology partner · www.astrologybot.com · contact@astrologybot.com</span>
            <span>Page 3</span>
        </div>
    </div>

    <!-- Chart Rendering Macro -->
    <% function renderChart(chartData, title) { 
        const pos = {
            1: { x: 160, y: 50, sx: 160, sy: 130 },
            2: { x: 70, y: 30, sx: 110, sy: 70 },
            3: { x: 30, y: 70, sx: 70, sy: 110 },
            4: { x: 50, y: 160, sx: 130, sy: 160 },
            5: { x: 30, y: 250, sx: 70, sy: 210 },
            6: { x: 70, y: 290, sx: 110, sy: 250 },
            7: { x: 160, y: 270, sx: 160, sy: 190 },
            8: { x: 250, y: 290, sx: 210, sy: 250 },
            9: { x: 290, y: 250, sx: 250, sy: 210 },
            10: { x: 270, y: 160, sx: 190, sy: 160 },
            11: { x: 290, y: 70, sx: 250, sy: 110 },
            12: { x: 250, y: 30, sx: 210, sy: 70 },
        };
    %>
        <div class="ni-chart-container">
            <h3 class="ni-title"><%= title %></h3>
            <svg class="chart-svg" viewBox="0 0 320 320" width="320" height="320">
                <rect x="0" y="0" width="320" height="320" fill="none" stroke="#a88e5d" stroke-width="2"/>
                <line x1="0" y1="0" x2="320" y2="320" stroke="#a88e5d" stroke-width="1.5"/>
                <line x1="320" y1="0" x2="0" y2="320" stroke="#a88e5d" stroke-width="1.5"/>
                <polygon points="160,0 320,160 160,320 0,160" fill="none" stroke="#a88e5d" stroke-width="1.5"/>
                
                <!-- Corner Ornaments -->
                <polygon points="0,0 15,0 0,15" fill="#a88e5d"/>
                <polygon points="320,0 305,0 320,15" fill="#a88e5d"/>
                <polygon points="0,320 15,320 0,305" fill="#a88e5d"/>
                <polygon points="320,320 305,320 320,305" fill="#a88e5d"/>
                
                <% for (let i = 1; i <= 12; i++) { %>
                    <text x="<%= pos[i].sx %>" y="<%= pos[i].sy %>" class="sign-text"><%= chartData[i].signNum %></text>
                    <% if (chartData[i].planets.length > 0) { %>
                        <text x="<%= pos[i].x %>" y="<%= pos[i].y %>" class="planet-text">
                            <% chartData[i].planets.forEach((p, idx) => { %>
                                <tspan class="color-<%= p %>" dx="<%= idx > 0 ? 5 : 0 %>"><%= p %></tspan>
                            <% }); %>
                        </text>
                    <% } %>
                <% } %>
            </svg>
        </div>
    <% } %>

    <!-- Page 2: Divisional Chart I -->
    <div class="page">
        <div class="page-header">
            <div class="header-line"></div>
            <div class="page-number">03</div>
            <h2 class="page-title">Divisional Charts I</h2>
        </div>
        <h3 class="section-heading">LAGNA (D1) & HORA (D2)</h3>
        <% if (d1Chart) { renderChart(d1Chart, 'D1 Rasi'); } %>
        <% if (d2Chart) { renderChart(d2Chart, 'D2 Hora'); } %>
    </div>
    <!-- Page 3: Divisional Chart II -->
    <div class="page">
        <h3 class="section-heading">DREKKANA (D3) & CHATURTHAMSHA (D4)</h3>
        <% if (d3Chart) { renderChart(d3Chart, 'D3 Drekkana'); } %>
        <% if (d4Chart) { renderChart(d4Chart, 'D4 Chaturthamsha'); } %>
    </div>
    <!-- Page 4: Divisional Chart III -->
    <div class="page">
        <h3 class="section-heading">SAPTAMSHA (D7) & NAVAMSHA (D9)</h3>
        <% if (d7Chart) { renderChart(d7Chart, 'D7 Saptamsha'); } %>
        <% if (d9Chart) { renderChart(d9Chart, 'D9 Navamsha'); } %>
    </div>
    <!-- Page 5: Divisional Chart IV -->
    <div class="page">
        <h3 class="section-heading">DASHAMAMSHA (D10) & DWADASHAMSHA (D12)</h3>
        <% if (d10Chart) { renderChart(d10Chart, 'D10 Dashamamsha'); } %>
        <% if (d12Chart) { renderChart(d12Chart, 'D12 Dwadashamsha'); } %>
    </div>
    <!-- Page 6: Divisional Chart V -->
    <div class="page">
        <h3 class="section-heading">SHODASHAMSHA (D16) & VIMSHAMSHA (D20)</h3>
        <% if (d16Chart) { renderChart(d16Chart, 'D16 Shodashamsha'); } %>
        <% if (d20Chart) { renderChart(d20Chart, 'D20 Vimshamsha'); } %>
    </div>
    <!-- Page 6b: Divisional Chart VI -->
    <div class="page">
        <h3 class="section-heading">CHATURVIMSAMSHA (D24) & SAPTAVIMSAMSHA (D27)</h3>
        <% if (d24Chart) { renderChart(d24Chart, 'D24 Chaturvimsamsa'); } %>
        <% if (d27Chart) { renderChart(d27Chart, 'D27 Saptavimsamsa'); } %>
    </div>
    <!-- Page 6c: Divisional Chart VII -->
    <div class="page">
        <h3 class="section-heading">TRIMSAMSHA (D30) & KHAVEDAMSHA (D40)</h3>
        <% if (d30Chart) { renderChart(d30Chart, 'D30 Trimsamsa'); } %>
        <% if (d40Chart) { renderChart(d40Chart, 'D40 Khavedamsa'); } %>
    </div>
    <!-- Page 6d: Divisional Chart VIII -->
    <div class="page">
        <h3 class="section-heading">AKSHAVEDAMSHA (D45) & SHASTIAMSHA (D60)</h3>
        <% if (d45Chart) { renderChart(d45Chart, 'D45 Akshavedamsa'); } %>
        <% if (d60Chart) { renderChart(d60Chart, 'D60 Shastiamsa'); } %>
    </div>
    <!-- Page 6e: Surya & Chandra Charts -->
    <div class="page">
        <h3 class="section-heading">SURYA CHART (SUN) & CHANDRA CHART (MOON)</h3>
        <% if (suryaChart) { renderChart(suryaChart, 'Surya Chart'); } %>
        <% if (chandraChart) { renderChart(chandraChart, 'Chandra Chart'); } %>
    </div>

    <!-- Page 7: Planetary Positions -->
    <div class="page">
        <div class="page-header">
            <div class="header-line"></div>
            <div class="page-number">04</div>
            <h2 class="page-title">Planetary Positions</h2>
        </div>

        <table>
            <thead>
                <tr>
                    <th>PLANET</th>
                    <th>SIGN (LORD)</th>
                    <th>NAKSHATRA (LORD)</th>
                    <th>HOUSE</th>
                    <th>DEGREE</th>
                    <th class="val">RETROGRADE</th>
                </tr>
            </thead>
            <tbody>
                <% planets.forEach(function(planet) { %>
                <tr>
                    <td><strong><%= planet.name %></strong></td>
                    <td><%= planet.sign %> (<%= planet.signLord %>)</td>
                    <td><%= planet.nakshatra %><br><span style="font-size: 10px; color: #888;">Lord: <%= planet.nakshatraLord %></span></td>
                    <td><strong><%= planet.house %></strong></td>
                    <td><%= planet.degrees %></td>
                    <td class="val"><%= planet.retrograde === 'True' ? 'R' : '-' %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="footer">
            <span>Astrology Bot — Your trusted astrology partner · www.astrologybot.com · contact@astrologybot.com</span>
            <span>Page 4</span>
        </div>
    </div>

    <!-- Page 8: KP System -->
    <div class="page">
        <div class="page-header">
            <div class="header-line"></div>
            <div class="page-number">05</div>
            <h2 class="page-title">KP System Analysis</h2>
        </div>

        <h3 class="section-heading">KP Ruling Planets</h3>
        <% if (kpRulingPlanets) { %>
        <table>
            <thead>
                <tr>
                    <th>RULING POINT</th>
                    <th>SIGN LORD</th>
                    <th>STAR LORD</th>
                    <th class="val">SUB LORD</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>Ascendant</strong></td>
                    <td><%= kpRulingPlanets.ascSignLord %></td>
                    <td><%= kpRulingPlanets.ascStarLord %></td>
                    <td class="val"><%= kpRulingPlanets.ascSubLord %></td>
                </tr>
                <tr>
                    <td><strong>Moon</strong></td>
                    <td><%= kpRulingPlanets.moonSignLord %></td>
                    <td><%= kpRulingPlanets.moonStarLord %></td>
                    <td class="val"><%= kpRulingPlanets.moonSubLord %></td>
                </tr>
                <tr>
                    <td><strong>Day Lord</strong></td>
                    <td colspan="3" class="val" style="text-align: right;"><%= kpRulingPlanets.dayLord %></td>
                </tr>
            </tbody>
        </table>
        <% } %>

        <h3 class="section-heading">KP Planetary Table</h3>
        <table>
            <thead>
                <tr>
                    <th>PLANET</th>
                    <th>SIGN LORD</th>
                    <th>STAR LORD</th>
                    <th class="val">SUB LORD</th>
                </tr>
            </thead>
            <tbody>
                <% planets.forEach(function(planet) { %>
                <tr>
                    <td><strong><%= planet.name %></strong></td>
                    <td><%= planet.kpSignLord %></td>
                    <td><%= planet.kpStarLord %></td>
                    <td class="val"><strong><%= planet.kpSubLord %></strong></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="footer">
            <span>Astrology Bot — Your trusted astrology partner · www.astrologybot.com · contact@astrologybot.com</span>
            <span>Page 5</span>
        </div>
    </div>

    <!-- Page 9: KP Cuspal Chart and Table -->
    <div class="page">
        <div class="page-header">
            <div class="header-line"></div>
            <div class="page-number">06</div>
            <h2 class="page-title">KP Cusps & Chalit</h2>
        </div>

        <h3 class="section-heading">KP Chalit Chart</h3>
        <p style="color: #666; font-size: 13px; margin-bottom: 20px;">Planets mapped to exact Placidus house boundaries.</p>
        <% if (kpChalitChart) { renderChart(kpChalitChart, 'KP Chalit'); } %>

        <h3 class="section-heading" style="margin-top: 30px;">KP Cuspal Table</h3>
        <% if (kpCusps && kpCusps.length > 0) { %>
        <table>
            <thead>
                <tr>
                    <th>HOUSE</th>
                    <th>DEGREE</th>
                    <th>SIGN LORD</th>
                    <th>STAR LORD</th>
